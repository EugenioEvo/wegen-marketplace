# Copie para .env.local e preencha com os valores do seu projeto Supabase.
# (Settings → API no painel do Supabase.) A chave publishable/anon é segura
# no cliente — o acesso é controlado por Row Level Security.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
